{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://szpbjbhgrocselypiafh.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "cmap-mcp",
      "version": "0.2.0",
      "title": "cMAP — Cosmic Mesh Alignment Protocol"
    },
    "tools": [
      {
        "name": "list_nodes",
        "title": "List sovereign nodes",
        "description": "List all declared sovereign mesh nodes in the cMAP fleet with region, role, tier, declared purpose, and public probe endpoint. Requires an active cMAP MCP subscription.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "tier": {
              "description": "Optional filter by declared tier.",
              "type": "string",
              "enum": [
                "measured",
                "attested",
                "doctrine"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_blades",
        "title": "List OMNI-SAM AXIS blades",
        "description": "List the 13 canonical OMNI-SAM AXIS blades of cMAP with status (LIVE, STANDBY, AWAITING), sovereign route, and tagline. Requires an active cMAP MCP subscription.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Optional filter by blade status.",
              "type": "string",
              "enum": [
                "LIVE",
                "STANDBY",
                "AWAITING"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "centralization_inventory",
        "title": "Centralization inventory",
        "description": "Return the honest inventory of every non-sovereign dependency the cMAP browser app has (analytics, fonts, host, probes), the removable status of each, and the migration path to sovereignty. Requires an active cMAP MCP subscription.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
