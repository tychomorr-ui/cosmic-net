[Unit]
Description=Nexinus archangel — sovereign node daemon
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=archangel
Group=archangel
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/archangel
ExecStart=/usr/local/bin/archangel serve \
    --endpoint=${ARCHANGEL_ENDPOINT} \
    --iface=wg0 \
    --etc=/etc/archangel \
    --tls-cert=/etc/archangel/tls.crt \
    --tls-key=/etc/archangel/tls.key
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
