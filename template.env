# ─────────────────────────────────────────────────────────────────────────────
# NEXINUS / cMAP — environment template
# Copy to `.env` (or `.env.development`) and fill in. NEVER commit a real .env.
#
# Classification:
#   PUBLIC  — shipped to the browser. Safe to expose. Must be prefixed VITE_.
#   SERVER  — read only inside server function / route handlers via process.env.
#   LOCAL   — developer/operator tooling only, never part of the deployed app.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend (Lovable Cloud / Supabase) ───────────────────────────────────────
# PUBLIC. Base URL of the backend API used by the browser client.
VITE_SUPABASE_URL=
# PUBLIC. Publishable (anon) key. RLS is the access control, not this key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# PUBLIC. Project reference. Also used to derive the MCP OAuth issuer.
VITE_SUPABASE_PROJECT_ID=

# SERVER. Auto-provisioned in the deployed runtime; do not set by hand locally
# unless you are running server functions against a real project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER. Bypasses RLS. Never log it, never return it, never ship it to a client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# PUBLIC. Publishable client token used by Stripe.js on /pricing.
VITE_PAYMENTS_CLIENT_TOKEN=
# SERVER. Secret API key. Managed by the payments connector in production.
STRIPE_SANDBOX_API_KEY=
# SERVER. Verifies inbound Stripe webhook signatures at
# /api/public/payments/webhook. Requests failing verification are rejected 401.
PAYMENTS_SANDBOX_WEBHOOK_SECRET=

# ── AI gateway ───────────────────────────────────────────────────────────────
# SERVER. Auth for the model gateway and connector gateway. Server-side only.
LOVABLE_API_KEY=

# ── Scheduled probe hook ─────────────────────────────────────────────────────
# SERVER. Shared secret required by /api/public/hooks/reprobe. The pg_cron job
# `reprobe-mesh-15m` presents this; unauthenticated calls are rejected.
REPROBE_HOOK_SECRET=

# ── Analytics (opt-in, OFF by default) ───────────────────────────────────────
# PUBLIC. Leave blank to keep the platform at zero network telemetry.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ── Contracts (LOCAL only — contracts/.env, never the app) ───────────────────
# LOCAL. Dedicated deployment key. Use a fresh key. NEVER a mainnet key.
PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# LOCAL. Optional — enables contract source verification on Basescan.
BASESCAN_API_KEY=
