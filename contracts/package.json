{
  "name": "truth-coin-contracts",
  "version": "0.0.1",
  "private": true,
  "description": "Hardhat scaffold to deploy TruthCoin.sol to Base Sepolia.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy-local.js",
    "preflight": "hardhat run scripts/preflight.js",
    "deploy:base-sepolia": "hardhat run scripts/deploy.js --network baseSepolia",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "verify:base-sepolia": "hardhat verify --network baseSepolia",
    "readout": "hardhat run scripts/readout.js --network baseSepolia",
    "safe:transfer": "node scripts/prepare-safe-transfer.js",
    "audit:bundle": "node scripts/audit-bundle.js",
    "deploy:blades": "hardhat run scripts/deploy-blades.js",
    "deploy:blades:base-sepolia": "hardhat run scripts/deploy-blades.js --network baseSepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.10"
  }
}
