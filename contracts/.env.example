# Copy to .env and fill in. NEVER commit .env.
# Use a FRESH key. Never your mainnet key.
PRIVATE_KEY=0xreplace_with_a_dedicated_testnet_private_key

# Optional overrides
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional — enables `npm run verify:base-sepolia <ADDRESS>`
BASESCAN_API_KEY=
